# ============================================================
# 네이버 개발자센터(developers.naver.com)에서 발급받은 값을
# 아래에 입력한 뒤, 이 파일 이름을 ".env" 로 바꿔주세요.
# (".env.example" -> ".env")
# ============================================================

NAVER_CLIENT_ID=여기에_Client_ID_입력
NAVER_CLIENT_SECRET=여기에_Client_Secret_입력

# 네이버 개발자센터 앱 설정 화면의 "Callback URL"에
# 아래 주소를 정확히 그대로 등록하세요.
NAVER_REDIRECT_URI=http://localhost:3000/callback

# 서버가 사용할 포트 (특별한 이유가 없다면 바꾸지 마세요)
PORT=3000

# 채용공고 데이터를 저장할 PostgreSQL 연결 문자열.
# Render에 배포하면 Render Postgres가 이 값을 자동으로 주입합니다.
# 로컬 개발 시에는 로컬에 설치된 Postgres 또는 무료 Postgres 인스턴스
# (Render/Neon/Supabase 등)의 연결 문자열을 직접 입력하세요.
# 설정하지 않으면 서버는 정상 실행되지만 /api/jobs 관련 기능은 비활성화됩니다.
DATABASE_URL=postgres://user:password@localhost:5432/ai_recruit_dashboard
